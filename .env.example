# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model Settings
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_MODEL_TEMPERATURE=0.2

# Embedding Settings
EMBEDDING_MODEL_NAME=text-embedding-005
VECTOR_DIMENSIONS=768
VERTEX_AGENT_ENGINE_ID=
USE_CLOUD_AGENT=true
GOOGLE_CLOUD_STORAGE_BUCKET=

# OTEL prompt/response logging requirements for evaluation
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY


# Cloud SQL PostgreSQL database configurations
DB_USER=app_user
DB_PASSWORD=your_password
DB_NAME=ediscovery
DB_HOST=127.0.0.1
DB_PORT=5433


AGENT_GATEWAY=ediscovery-safety-policy
